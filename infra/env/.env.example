# AI
# ключи 
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
# стандартные модели
OPENAI_CHAT_MODEL=gpt-5.6-terra        # режим «Общий» (стандарт)
OPENAI_RESEARCH_MODEL=gpt-5.6-terra    # режим «Исследовать» (Responses API + web_search)
ANTHROPIC_CODE_MODEL=claude-sonnet-5   # режим «Код» (стандарт)
OPENAI_MEMORY_MODEL=gpt-5-nano         # извлечение фактов глобальной памяти 
# быстрые модели
OPENAI_CHAT_MODEL_FAST=gpt-5.6-luna
ANTHROPIC_CODE_MODEL_FAST=claude-haiku-4-5
OPENAI_RESEARCH_MODEL_FAST=gpt-5.6-luna
# качественные модели
ANTHROPIC_CODE_MODEL_QUALITY=claude-opus-5
OPENAI_CHAT_MODEL_QUALITY=gpt-5.6-sol
OPENAI_RESEARCH_MODEL_QUALITY=gpt-5.6-sol
# модели деградации при исчерпании квоты
OPENAI_CHAT_MODEL_DEGRADE=gpt-5-nano
OPENAI_RESEARCH_MODEL_DEGRADE=gpt-5-nano
ANTHROPIC_CODE_MODEL_DEGRADE=claude-haiku-4-5

# Clerk (backend — верификация JWT сессии)
CLERK_JWKS_URL=https://your-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-frontend-api.clerk.accounts.dev
