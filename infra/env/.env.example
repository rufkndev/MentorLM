# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # прод: https://mentorlm.ru
NEXT_PUBLIC_API_URL=http://localhost:8000   # прод: https://mentorlm.ru

# ── Backend ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-a-random-secret   # прод: настоящий случайный ключ
DEBUG=True                                             # прод: игнорируется, там всегда False
ALLOWED_HOSTS=localhost,127.0.0.1                      # прод: mentorlm.ru,www.mentorlm.ru
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# прод: https://mentorlm.ru,https://www.mentorlm.ru
CSRF_TRUSTED_ORIGINS=
# прод: пусто — фронт и API на одном домене, CORS не участвует
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Postgres ──────────────────────────────────────────────────────────────────
# Единственное место, где заданы данные базы: отсюда их берут и контейнер
# postgres (создаёт базу), и Django (подключается) — в деве и в проде одинаково.
POSTGRES_DB=mentorlm_dev        # прод: mentorlm
POSTGRES_USER=mentorlm
POSTGRES_PASSWORD=mentorlm      # прод: длинный случайный пароль
POSTGRES_HOST=127.0.0.1         # внутри compose перекрывается на db
POSTGRES_PORT=5433              # внутри compose перекрывается на 5432

# ── Redis ─────────────────────────────────────────────────────────────────────
# База 1 — дев, 0 — прод. В проде значение задаёт compose 
REDIS_URL=redis://127.0.0.1:6379/1

# кэш в памяти процесса вместо Redis.
# ALLOW_LOCMEM_CACHE=1

# ── Почта: Yandex Cloud Postbox ───────────────────────────────────────────────
POSTBOX_KEY_ID=
POSTBOX_SECRET=
# Адрес отправителя. Должен быть подтверждён в Postbox, иначе письмо отклонят.
# прод: MentorLM <no-reply@mentorlm.ru>
DEFAULT_FROM_EMAIL=
# Куда уходят ответы на письма (Reply-To) и куда писать по вопросам.
SUPPORT_EMAIL=support@mentorlm.ru
# Адрес ФРОНТА — из него собираются ссылки в письмах. прод: https://mentorlm.ru
PUBLIC_SITE_URL=http://localhost:3000
# Хост и порт SMTP: 587 — STARTTLS, 465 — TLS сразу. Менять только при смене
# провайдера почты.
# EMAIL_HOST=postbox.cloud.yandex.net
# EMAIL_PORT=587

# ── AI: ключи ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key

# ── AI: прокси ────────────────────────────────────────────────────────────────
LLM_PROXY_URL=

# ── AI: модели ────────────────────────────────────────────────────────────────
# стандартные
OPENAI_CHAT_MODEL=gpt-5.6-terra        # режим «Общий» (стандарт)
OPENAI_RESEARCH_MODEL=gpt-5.6-terra    # режим «Исследовать» (Responses API + web_search)
ANTHROPIC_CODE_MODEL=claude-sonnet-5   # режим «Код» (стандарт)
OPENAI_MEMORY_MODEL=gpt-5-nano         # извлечение фактов глобальной памяти
# быстрые
OPENAI_CHAT_MODEL_FAST=gpt-5.6-luna
ANTHROPIC_CODE_MODEL_FAST=claude-haiku-4-5
OPENAI_RESEARCH_MODEL_FAST=gpt-5.6-luna
# качественные
ANTHROPIC_CODE_MODEL_QUALITY=claude-opus-5
OPENAI_CHAT_MODEL_QUALITY=gpt-5.6-sol
OPENAI_RESEARCH_MODEL_QUALITY=gpt-5.6-sol
# деградация при исчерпании квоты
OPENAI_CHAT_MODEL_DEGRADE=gpt-5-nano
OPENAI_RESEARCH_MODEL_DEGRADE=gpt-5-nano
ANTHROPIC_CODE_MODEL_DEGRADE=claude-haiku-4-5
