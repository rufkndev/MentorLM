# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend
DJANGO_SECRET_KEY=change-me-generate-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Кэш: лок генерации, rate limit, «Стоп». Пусто → память процесса (dev в один
# воркер). В проде ОБЯЗАТЕЛЕН общий Redis, иначе лимиты считает каждый воркер сам.
# REDIS_URL=redis://127.0.0.1:6379/0

# Database
SUPABASE_NAME=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=postgres
SUPABASE_HOST=db.lfbjmqixyvmflukpymdj.supabase.co
SUPABASE_PORT=5432

# Yandex Cloud
YANDEX_API_KEY=your_yandex_key
# YANDEX_FOLDER_ID=your_folder_id

# AI Services
OPENAI_API_KEY=your_openai_key
OPENAI_CHAT_MODEL=gpt-5.5           # режим «Общий» (флагман)
OPENAI_RESEARCH_MODEL=gpt-5.5         # режим «Исследовать» (Responses API + web_search)
OPENAI_MEMORY_MODEL=gpt-5-nano       # извлечение фактов глобальной памяти (дёшево)
ANTHROPIC_API_KEY=your_anthropic_key
ANTHROPIC_CODE_MODEL=claude-sonnet-4-6  # режим «Код» (флагман)
# Тиры моделей для настройки «Модель ИИ» (default/fast/quality). default = модели
# выше; fast — дешевле; quality пуст → откат на флагман. Стоимость каждого тира
# учитывается в billing.limits.MODEL_COST_FACTOR (обновлять при смене моделей).
OPENAI_CHAT_MODEL_FAST=gpt-5
# OPENAI_CHAT_MODEL_QUALITY=
ANTHROPIC_CODE_MODEL_FAST=claude-haiku-4-5
# ANTHROPIC_CODE_MODEL_QUALITY=
OPENAI_RESEARCH_MODEL_FAST=gpt-5
# OPENAI_RESEARCH_MODEL_QUALITY=
# Модели деградации при исчерпании квоты (несколько запросов вместо блока).
OPENAI_CHAT_MODEL_DEGRADE=gpt-5-mini
OPENAI_RESEARCH_MODEL_DEGRADE=gpt-5-mini
ANTHROPIC_CODE_MODEL_DEGRADE=claude-haiku-4-5

# Clerk (frontend/mentorlm/.env.local)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Clerk (backend — верификация JWT сессии)
CLERK_JWKS_URL=https://your-frontend-api.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-frontend-api.clerk.accounts.dev
